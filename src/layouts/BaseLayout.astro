---
import "../styles/global.css";
import { profile, nav } from "../site";
import { url } from "../lib/content";
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}
const {
  title,
  description = profile.description,
  article = false,
} = Astro.props;
const fullTitle = title
  ? `${title} — ${profile.name}`
  : `${profile.name} — Research & Engineering`;
const canonical = new URL(
  Astro.url.pathname.endsWith("/404/") ? url("404.html") : Astro.url.pathname,
  Astro.site,
);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={new URL(url("og.png"), Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Articles & Notes"
      href={url("rss.xml")}
    />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("theme");
          document.documentElement.dataset.theme =
            t === "light" || t === "dark"
              ? t
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch {
          document.documentElement.dataset.theme = matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches
            ? "dark"
            : "light";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url("/")} aria-label={`${profile.name} Home`}>
          <span class="brand-icon">
            s<span>.</span>
          </span>
          {profile.name}
          <span class="brand-dot"></span>
        </a>
        <nav aria-label="メインナビゲーション">
          {nav.map(([label, path]) => (
            <a
              href={url(path)}
              aria-current={
                (
                  path === "/"
                    ? Astro.url.pathname === url("/")
                    : Astro.url.pathname.startsWith(url(path))
                )
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="header-tools">
          <a
            href={url("search/")}
            aria-label="サイト内検索"
            class="icon-button"
          >
            <svg
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 5 5" />
            </svg>
          </a>
          <button
            id="theme-toggle"
            class="icon-button"
            aria-label="配色を切り替え（現在：システム）"
            title="システム → ライト → ダーク"
          >
            ◐
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="container site-footer">
      <div>
        <a class="brand" href={url("/")}>
          {profile.name}
          <span class="brand-dot"></span>
        </a>
        <p>小さな発見を、次の一歩へ。</p>
      </div>
      <div class="footer-right">
        <div>
          {profile.links.map((link) => (
            <a href={link.url}>{link.label} ↗</a>
          ))}
          <a href={url("rss.xml")}>RSS ↗</a>
        </div>
        <span>
          © {new Date().getFullYear()} {profile.name} · Built with Astro
        </span>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const media = matchMedia("(prefers-color-scheme: dark)");
      function preference() {
        try {
          const value = localStorage.getItem("theme");
          return value === "light" || value === "dark" ? value : "system";
        } catch {
          return "system";
        }
      }
      function apply(value: string) {
        document.documentElement.dataset.theme =
          value === "system" ? (media.matches ? "dark" : "light") : value;
        if (button)
          button.setAttribute(
            "aria-label",
            `配色を切り替え（現在：${{ system: "システム", light: "ライト", dark: "ダーク" }[value]}）`,
          );
      }
      let current = preference();
      apply(current);
      button?.addEventListener("click", () => {
        const modes = ["system", "light", "dark"];
        const next = modes[(modes.indexOf(current) + 1) % 3];
        current = next;
        try {
          if (next === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {}
        apply(next);
      });
      media.addEventListener("change", () => apply(current));
    </script>
  </body>
</html>
