---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import { profile } from "../site";
---

<BaseLayout title="About">
  <PageHeading
    label="01 / ABOUT"
    title="自己紹介"
  />
  <div class="info-grid">
    <section class="panel">
      <p class="eyebrow">PROFILE / 準備中</p>
      <h2>{profile.name}</h2>
      <p>{profile.intro}</p>
      {profile.links.map((link) => (
        <a class="text-link" href={link.url}>
          {link.label} ↗
        </a>
      ))}
    </section>
    <section class="panel">
      <h2>関心領域</h2>
      <div class="tags">
        {profile.fields.map((field) => (
          <span>{field}</span>
        ))}
      </div>
      <h3>技術スタック（表示例）</h3>
      <p>{profile.stack.join(" / ")}</p>
      <p class="muted">
        使用経験を示すものではありません。実際のプロフィールに差し替えてください。
      </p>
    </section>
    <section class="panel">
      <h2>学歴・経歴</h2>
      {profile.education.map((text) => (
        <p>{text}</p>
      ))}
    </section>
    <section class="panel">
      <h2>活動歴</h2>
      {profile.activities.map((text) => (
        <p>{text}</p>
      ))}
    </section>
  </div>
</BaseLayout>
