---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { allPosts, url } from "../lib/content";
import { profile } from "../site";
const recent = (await allPosts()).slice(0, 4);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).slice(0, 2);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> PERSONAL PORTFOLIO & FIELD NOTES
      </p>
      <h1>
        つくる。測る。
        <br />
        考えを、<span class="accent">つなぐ。</span>
      </h1>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a class="button" href={url("articles/")}>
          記事を読む <span>↗</span>
        </a>
        <a class="text-link" href={url("about/")}>
          About me <span>→</span>
        </a>
      </div>
      <div class="hero-signature">
        <strong>{profile.name}</strong>
        <span>{profile.role}</span>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="orbital orbital-one"></div>
      <div class="orbital orbital-two"></div>
      <div class="orbital orbital-three"></div>
      <div class="art-axis axis-x"></div>
      <div class="art-axis axis-y"></div>
      <span class="art-point point-one"></span>
      <span class="art-point point-two"></span>
      <span class="art-coordinate">FIG. 01 — CONNECTING IDEAS</span>
      <span class="art-label">
        observation
        <br />↓<br />
        understanding
      </span>
      <span class="art-center">
        s<span>.</span>
      </span>
    </div>
  </section>
  <div class="field-strip">
    <span class="eyebrow">EXPLORING</span>
    {profile.fields.map((field, i) => (
      <span>
        <small>0{i + 1}</small>
        {field}
      </span>
    ))}
    <span class="strip-end">常に、学びの途中。 ↗</span>
  </div>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>研究とプロジェクト</h2>
      </div>
      <a class="text-link" href={url("projects/")}>
        すべて見る →
      </a>
    </div>
    <p class="section-lead">アイデアをかたちにする、実験と開発の記録。</p>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
    <a class="research-link" href={url("research/")}>
      <span class="eyebrow">RESEARCH</span>
      <span>研究テーマ・発表について</span>
      <span>→</span>
    </a>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LATEST WRITING</p>
        <h2>最近の記事とメモ</h2>
      </div>
      <a class="text-link" href={url("articles/")}>
        Articles →
      </a>
    </div>
    <PostList entries={recent} />
  </section>
  <aside class="notice">
    <span class="status-dot"></span>
    <p>{profile.notice}</p>
    <a href={profile.links[0].url}>GitHub ↗</a>
  </aside>
</BaseLayout>
