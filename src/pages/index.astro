---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { allPosts, url } from "../lib/content";
import { profile } from "../site";
const recent = (await allPosts()).slice(0, 4);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).slice(0, 2);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> PERSONAL PORTFOLIO & FIELD NOTES
      </p>
      <h1>{profile.name}<span class="accent">.</span></h1>
      <p class="hero-intro">{profile.role}</p>
      <div class="hero-actions">
        <a class="button" href={url("blog/")}>
          Blog を読む <span>↗</span>
        </a>
        <a class="text-link" href={url("about/")}>
          About me <span>→</span>
        </a>
      </div>

    </div>
    <div class="hero-art">
      <img
        class="hero-avatar"
        src={profile.avatar}
        alt={`${profile.name}のGitHubプロフィール写真`}
        width="800"
        height="800"
        fetchpriority="high"
      />
    </div>
  </section>
  <div class="field-strip">
    <span class="eyebrow">EXPLORING</span>
    {profile.fields.map((field, i) => (
      <span>
        <small>0{i + 1}</small>
        {field}
      </span>
    ))}
  </div>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>研究とプロジェクト</h2>
      </div>
      <a class="text-link" href={url("projects/")}>
        すべて見る →
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
    <a class="research-link" href={url("research/")}>
      <span class="eyebrow">RESEARCH</span>
      <span>研究テーマ・発表について</span>
      <span>→</span>
    </a>
  </section>
  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LATEST WRITING</p>
        <h2>最近の投稿</h2>
      </div>
      <a class="text-link" href={url("blog/")}>
        Blog →
      </a>
    </div>
    <PostList entries={recent} />
  </section>
  <aside class="notice">
    <a href={profile.links[0].url}>GitHub ↗</a>
  </aside>
</BaseLayout>
