---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../lib/content";
export async function getStaticPaths() {
  return (await getCollection("projects", ({ data }) => !data.draft)).map(
    (project) => ({ params: { id: project.id }, props: { project } }),
  );
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <header class="page-heading">
    <p class="eyebrow">PROJECT / DEMO</p>
    <h1>{project.data.title}</h1>
    <p>{project.data.description}</p>
    <div class="tags">
      {project.data.tags.map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
  </header>
  <div class="prose">
    <Content />
    {project.data.repository && (
      <p>
        <a href={project.data.repository}>GitHub リポジトリ ↗</a>
      </p>
    )}
    {project.data.demo && (
      <p>
        <a href={project.data.demo}>デモ ↗</a>
      </p>
    )}
  </div>
  <p>
    <a class="text-link" href={url("projects/")}>
      ← Projects
    </a>
  </p>
</BaseLayout>
